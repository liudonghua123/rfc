      <section anchor="cipher-suites" numbered="true" removeInRFC="false" toc="include" pn="section-4.2">
        <name slugifiedName="name-cipher-suites-for-aes-256-c">Cipher Suites for AES-256-CTR with HMAC-SHA512</name>
        <t indent="0" pn="section-4.2-1">IANA has added the following new entries to the "SFrame Cipher Suites" registry:</t>
        <table anchor="new-entries" align="center" pn="table-2">
          <name slugifiedName="name-new-entries-in-the-sframe-c">New Entries in the SFrame Cipher Suites Registry</name>
          <thead>
            <tr>
              <th align="left" colspan="1" rowspan="1">Value</th>
              <th align="left" colspan="1" rowspan="1">Name</th>
              <th align="left" colspan="1" rowspan="1">Nh</th>
              <th align="left" colspan="1" rowspan="1">Nka</th>
              <th align="left" colspan="1" rowspan="1">Nk</th>
              <th align="left" colspan="1" rowspan="1">Nn</th>
              <th align="left" colspan="1" rowspan="1">Nt</th>
              <th align="left" colspan="1" rowspan="1">R</th>
              <th align="left" colspan="1" rowspan="1">Reference</th>
              <th align="left" colspan="1" rowspan="1">Ch Contr</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td align="left" colspan="1" rowspan="1">0x0006</td>
              <td align="left" colspan="1" rowspan="1">
                <tt>AES_256_CTR_HMAC_SHA512_80</tt></td>
              <td align="left" colspan="1" rowspan="1">64</td>
              <td align="left" colspan="1" rowspan="1">32</td>
              <td align="left" colspan="1" rowspan="1">96</td>
              <td align="left" colspan="1" rowspan="1">12</td>
              <td align="left" colspan="1" rowspan="1">10</td>
              <td align="left" colspan="1" rowspan="1">Y</td>
              <td align="left" colspan="1" rowspan="1">RFC 10079</td>
              <td align="left" colspan="1" rowspan="1">IETF</td>
